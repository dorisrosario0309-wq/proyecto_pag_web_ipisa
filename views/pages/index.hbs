{{#block "styles"}}
    <link rel="stylesheet" href="/css/Inicio.css">
{{/block}}

<header class="hero-section position-relative text-white d-flex align-items-center">
    <div class="container position-relative z-1">
        <h1 class="display-4 fw-bold mb-3" style="max-width: 600px;">
            La ferretería más grande del país. 
        </h1>
        <h2>
            ¡Donde encuentras más de lo que buscas!
        </h2>
    </div>
</header>

<section class="container py-5">
    <h2 class="text-center fw-bold mb-5 section-title">Servicios principales</h2>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="text-center fw-bold mb-5 section-title">
                <a href="#">
                    <img src="/img/guias.jpg" class="img-fluid rounded shadow-sm" alt="Guías Bellon">
                    <p class="mt-2 fst-italic fw-bold text-orange">Guías Bellon</p>
                </a>
            </div>
        </div>
        <div class="col-md-6">
            <div class="Envios a tu hogar">
                <a href="#">
                    <img src="/img/envios.jpg" class="img-fluid rounded shadow-sm" alt="Envíos a tu hogar">
                    <p class="mt-2 fst-italic fw-bold text-orange">Envíos a tu hogar</p>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <h2 class="text-center fw-bold mb-5 section-title">Compras por categoría</h2>
    <div class="row row-cols-2 row-cols-md-4 g-5 text-center">
        <div class="col category-item">
            <a href="/categoria/ferreteria">
                <img src="/img/Ferreteria.jpg" alt="Ferretería">
                <p class="fw-bold mt-2">Ferretería</p>
            </a>
        </div>
        <div class="col category-item">
            <a href="#">
                <img src="/img/Electricos.jpg" alt="Eléctricos">
                <p class="fw-bold mt-2">Eléctricos</p>
            </a>
        </div>
        <div class="col category-item">
            <a href="#">
                <img src="/img/Pinturas.jpg" alt="Pinturas">
                <p class="fw-bold mt-2">Pinturas</p>
            </a>
        </div>
        <div class="col category-item">
            <a href="#">
                <img src="/img/Construccion.jpg" alt="Construcción">
                <p class="fw-bold mt-2">Construcción</p>
            </a>
        </div>
        <div class="col category-item">
            <a href="#">
                <img src="/img/Baños.jpg" alt="Baños">
                <p class="fw-bold mt-2">Baños</p>
            </a>
        </div>
        <div class="col category-item">
            <a href="#">
                <img src="/img/Exteriortemporada.jpg" alt="Exterior">
                <p class="fw-bold mt-2">Exterior y Temporada</p>
            </a>
        </div>
        <div class="col category-item">
            <a href="#">
                <img src="/img/Iluminacion.jpg" alt="Iluminación">
                <p class="fw-bold mt-2">Iluminación</p>
            </a>
        </div>
        <div class="col category-item">
            <a href="#">
                <img src="/img/Madera.jpg" alt="Madera">
                <p class="fw-bold mt-2">Madera</p>
            </a>
        </div>
    </div>
</section>