{{#block "styles"}}
    <link rel="stylesheet" href="/css/contacto.css">
{{/block}}

 <body>
    <section class="container py-5">
        <h2 class="text-center fw-bold mb-5 section-title">Contactos</h2>
    </section>
    <section class="contacto-1">
        <div class="logo-contacto">
            <div class="mb-2">
              <div class="d-flex flex-column align-items-center">
                <i class="fa-solid fa-phone" style="color: rzgb(30, 48, 80); font-size: 2rem;"></i>
                <h4 class="text-dark fw-bold">Contacto</h4>
                <p class="mb-0 text-black">
                  <a href="tel:1-809-226-5555" class="text-black">(809) 226-5555</a>
                </p>
              </div>
              <h5 class="Extensiones">
                Extensiones a nivel Nacionales
              </h5>
              <p class="Cuentas-cobrar">
                <i class="fa-solid fa-circle fa-2xs text-blue me-1"></i>
                Cuentas por Cobrar Ext. <b>1225</b>
              </p>
              <p class="Cuentas-pagar">
                <i class="fa-solid fa-circle fa-2xs text-blue me-1"></i>
                Cuentas por Pagar Ext. <b>1236</b>
              </p>
              <p class="Transport">
                <i class="fa-solid fa-circle fa-2xs text-blue me-1"></i>
                Transportación Ext. <b>1282</b>
              </p>
              <p class="Ventas">
                <i class="fa-solid fa-circle fa-2xs text-blue me-1"></i>
                Ventas al por mayor Ext. <b>1286</b>
              </p>  
              </p>
            </div>
        </div>
        <div class="col">
            <div class="d-flex flex-column align-items-center text-center mb-2">
              <div class="bg-white d-flex align-items-center justify-content-center mb-1" style="width: 50px; height: 50px; border-radius: 50px">
                <i class="fa fa-envelope-open" style="color: #1e3050; font-size: 2rem;"></i>
              </div>
              <h4 class="text-dark fw-bold">Email</h4>
              <p class="mb-0">
                <a href="mailto:info@bellon.com.do?Subject=Necesito%20una%20Informaci%C3%B3n" class="text-black">
                  info@bellon.com.do
                </a>
              </p>
            </div>
            <div class="mb-2">
              <div class="d-flex flex-column align-items-center">
                <div class="bg-white d-flex align-items-center justify-content-center mb-1" style="width: 50px; height: 50px; border-radius: 50px; border: 2px solid #1e3050;">
                  <i class="fa-solid fa-circle-info" style="color: #1e3050; font-size: 1.5rem;"></i>
                </div>
                <h4 class="text-dark fw-bold">Información</h4>
              </div>
              <p class="mb-0 text-black text-center">
                Puedes contactarnos para: preguntas, cotizaciones y compras.
              </p>
            </div>
          </div>
    </section>
  </body>