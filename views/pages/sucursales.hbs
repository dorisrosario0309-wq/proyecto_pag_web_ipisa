<div class="container py-5">
    <h1 class="text-center fw-bold mb-4">Sucursal de {{sucursal.nombre}}</h1>
    
    <div class="text-center mb-5">
        <h2 class="fw-bold">{{sucursal.nombre}}</h2>
        <hr class="mx-auto" style="width: 50px; border-top: 3px solid #ff8500;">
    </div>

    <div class="row align-items-center">
        <div class="col-md-6 text-center">
            <div class="mb-4">
                <i class="fas fa-envelope fa-2x mb-2"></i>
                <p><strong>Email</strong><br>{{sucursal.email}}</p>
            </div>
            <div class="mb-4">
                <i class="fas fa-map-marker-alt fa-2x mb-2"></i>
                <p><strong>Dirección</strong><br>{{sucursal.direccion}}</p>
            </div>
            <div class="mb-4">
                <i class="fas fa-clock fa-2x mb-2"></i>
                <p><strong>Horario</strong><br>{{sucursal.horario}}</p>
            </div>
            <div class="mb-4">
                <i class="fas fa-phone fa-2x mb-2"></i>
                <p><strong>Contacto</strong><br>{{sucursal.telefono}}</p>
            </div>
        </div>

        <div class="col-md-6">
            <img src="{{sucursal.mapa_img}}" alt="Mapa {{sucursal.nombre}}" class="img-fluid rounded shadow">
        </div>
    </div>
</div>