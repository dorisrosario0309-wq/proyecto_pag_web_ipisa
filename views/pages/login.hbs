{{#block "styles"}}
    <link rel="stylesheet" href="/css/login.css">
{{/block}}

<div class="col-12 col-md-6 d-flex flex-column justify-content-center align-items-center p-4 p-md-5 bg-white order-2 order-md-1">
    <div class="form-wrapper">
        <h2 class="text-center fw-bold mb-4 form-title-custom">Iniciar Sesión</h2>
        
        <form action="/login" method="POST">
            <div class="mb-3">
                <input type="text" class="form-control rounded-pill p-3 custom-input" placeholder="Nombre" name="nombre">
            </div>
            <div class="mb-3">
                <input type="password" class="form-control rounded-pill p-3 custom-input" placeholder="Contraseña" name="password">
            </div>
            
            <button type="submit" class="btn w-100 rounded-pill py-3 fw-bold text-white shadow btn-login-custom">
                Login
            </button>
        </form>
        
        <div class="text-center mt-4">
            <a href="/registrar" class="footer-link-bellon text-decoration-none small fw-medium">
                ¿No tienes cuenta? Pulsa aquí
            </a>
        </div>
    </div>
</div>